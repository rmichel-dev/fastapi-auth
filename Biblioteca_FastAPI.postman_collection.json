      "item": [
        {
          "name": "POST /books - Criar livro",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?title=Dom%20Casmurro&year=1899&author_id={{author_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "title",
                  "value": "Dom Casmurro"
